# Configuration Apache du site, deposee dans `public_html` avec le reste de
# `out/` — decision 0013.
#
# **Elle ne s'applique QUE si le site est servi par Apache**, c'est-a-dire sur un
# mutualise classique. Avec la « Node app » d'Hostinger, c'est `serveur.mjs` qui
# sert les fichiers et ce fichier reste inerte : les memes garanties — 404, types,
# cache, compression — y sont tenues en JavaScript. Deux chemins de service, deux
# endroits ou les ecrire, et c'est le seul doublon assume du depot.
#
# CE FICHIER EST LA SEULE FACON DE POSER UNE REDIRECTION OU UN EN-TETE ICI.
# `next.config.ts` est en `output: 'export'`, qui desactive `redirects`,
# `rewrites` et `headers`. Ce que le code ne peut pas dire, il le dit ici.
#
# Il vit dans `public/` et non dans `docs/` : c'est le contenu de `out/` qui est
# depose dans `public_html`, donc un fichier range ailleurs demanderait une copie
# manuelle a chaque mise en ligne — et serait oublie un jour.
#
# **Chaque bloc est garde par `IfModule`.** Une directive dont le module manque
# ne produit pas un avertissement sur un mutualise : elle rend le site entier en
# erreur 500. Le garde transforme cette panne en simple absence d'effet.

# --- La page 404 -------------------------------------------------------------
# `404.html` n'a aucun sens particulier pour Apache : c'est un fichier comme un
# autre, et sans cette ligne il ne serait jamais servi. Une adresse inconnue
# rendrait la page d'erreur generique de l'hebergeur.
#
# Vercel et Netlify branchent ce fichier tout seuls, par convention. Apache n'a
# pas cette convention.
ErrorDocument 404 /404.html

# Le contenu du site est public, la liste de ses dossiers n'a pas a l'etre.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS -----------------------------------------------------------------
  # Les 18 pages annoncent leur canonique en `https://`. Servir aussi le site en
  # clair donnerait deux adresses pour un meme contenu.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- `www` vers l'apex -----------------------------------------------------
  # `SITE_URL` (src/content/langues.ts) est sans `www`, et le sitemap, les
  # canoniques et les declarations hreflang en decoulent tous. Sans cette
  # redirection, deux hotes servent le meme site et le canonique arbitre ce que
  # la configuration aurait du empecher.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Cache -------------------------------------------------------------------
# `trailingSlash: true` fait que chaque page est un `index.html` dans son
# dossier. Ces fichiers changent a chaque mise en ligne et ne doivent jamais
# etre gardes ; les avoirs de `/_next/static/` portent un hachage dans leur nom,
# donc leur contenu ne change jamais a nom egal.
#
# Sans ces regles, un visiteur garde l'ancienne page apres une mise a jour, sans
# aucun moyen de le savoir.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------------------
# Mesure sur l'export : la page d'accueil passe de 250 Ko a 25 Ko. Sans
# compression, la cible de la decision 0006 est hors d'atteinte quoi qu'on fasse
# au code.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
